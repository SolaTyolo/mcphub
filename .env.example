# --- Storage (single LLM_STORE_DSN, scheme://path) ---
LLM_STORE_DSN=postgres://llm:llm@localhost:5433/llm?sslmode=disable
# LLM_STORE_DSN=sqlite://./data/llm.db
# LLM_STORE_DSN=file://./data/store.yml

# --- Local dev (Ollama + Whisper) ---
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_VISION_MODEL=llama3.2-vision

# --- Production (compatible API endpoint) ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o

LLM_SERVER_ADDR=:8090

GATEWAY_API_KEY=
MCP_IDLE_TTL=5m
AGENT_MAX_ROUNDS=10
MCP_FS_ROOT=/tmp

WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
